# Plantilla de variables de entorno. NO pongas valores reales en este fichero.
# Copia a .env.local y rellenalo. Ver docs/environment_setup.md.

# --- Base de datos (Neon / PostgreSQL) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth.js ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Jobs programados ---
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
# Solo en desarrollo: desvia TODO el correo a esta direccion.
EMAIL_REDIRECT_TO=

# --- Almacenamiento de imagenes ---
BLOB_READ_WRITE_TOKEN=

# --- Observabilidad (opcional) ---
SENTRY_DSN=
# DSN del navegador. Viaja en el paquete que se descarga el cliente: un DSN
# esta pensado para ser publico y no da acceso a leer nada.
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir los mapas de fuentes al desplegar. Sin ellas, el build
# funciona igual y las trazas llegan minificadas.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
